{# Adapted from LuCI Bootstrap footer, Apache-2.0. Preserve LuCI attribution. #}
{% if (!blank_page): %}
 </div>
 {% if (theme == 'atlas'): %}</div></div>{% endif %}
 <footer class="ax-footer">
  <span>Powered by <a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a> / <a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }}</a>{% if (lua_active): %} / {{ _('Lua compatibility mode active') }}{% endif %}</span>
  <a class="ax-credit" href="https://mrx-aid.github.io/" target="_blank" rel="noreferrer">Designed by Alexandr Azimov</a>
  <ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
 </footer>
 <script>L.require('menu-bootstrap')</script>
 <script>L.require('axel.telemetry').then(function(telemetry) { telemetry.start(); }).catch(function() { var ticker = document.querySelector('.ax-ticker'); if (ticker) ticker.textContent = 'Показатели недоступны'; });</script>
{% else %}</main>{% endif %}
 <script src="/luci-static/axel-core/shell.js?v=0.2.0-r4"></script>
</body>
</html>
